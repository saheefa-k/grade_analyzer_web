<div class="w-full px-6 py-8">
  <nav class="mb-8 flex flex-wrap gap-3 border-b border-base-300 pb-4">
    <.link
      href={~p"/"}
      class="rounded-lg px-4 py-2 transition-all duration-200 hover:bg-primary hover:text-primary-content"
    >Home</.link>
    <.link
      href={~p"/students"}
      class="rounded-lg bg-primary px-4 py-2 font-bold text-primary-content transition-all duration-200 hover:opacity-80"
    >All Students</.link>
    <.link
      href={~p"/class-analysis"}
      class="rounded-lg px-4 py-2 transition-all duration-200 hover:bg-primary hover:text-primary-content"
    >Class Analysis</.link>
  </nav>
  <h1 class="mb-6 text-3xl font-bold">All Students</h1>
  <div class="mb-8 rounded-xl border border-base-300 bg-base-100 p-6">
    <h2 class="mb-4 text-xl font-bold">Add Student</h2>
    <.form for={%{}} action={~p"/students"} method="post" class="space-y-4">
      <div>
        <label for="name" class="mb-1 block font-medium">Student Name</label>
        <input
          id="name"
          name="name"
          type="text"
          placeholder="Enter student name"
          class="input input-bordered w-full"
          required
        />
      </div>
      <div>
        <label for="marks_obtained" class="mb-1 block font-medium">Marks Obtained</label>
        <input
          id="marks_obtained"
          name="marks_obtained"
          type="number"
          min="0"
          step="any"
          placeholder="Enter obtained marks"
          class="input input-bordered w-full"
          required
        />
      </div>
      <div>
        <label for="total_marks" class="mb-1 block font-medium">Total Marks</label>
        <input
          id="total_marks"
          name="total_marks"
          type="number"
          min="0.01"
          step="any"
          placeholder="Enter total marks"
          class="input input-bordered w-full"
          required
        />
      </div>
      <button type="submit" class="btn btn-primary transition-all duration-200 hover:scale-105">Add Student</button>
    </.form>
  </div>
  <h2 class="mb-4 text-xl font-bold">Student Records</h2>
  <div class="overflow-x-auto">
    <table class="table table-zebra w-full">
      <thead>
        <tr>
          <th>Name</th>
          <th>Obtained Marks</th>
          <th>Total Marks</th>
          <th>Percentage</th>
          <th>Grade</th>
          <th>Status</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <%= for student <- @students do %>
          <tr class="transition-colors duration-200 hover:bg-base-200">
            <td>{student.name}</td>
            <td>{student.marks_obtained}</td>
            <td>{student.total_marks}</td>
            <td>{student.percentage}%</td>
            <td><span class="badge badge-primary">{student.grade}</span></td>
            <td>
              <%= if student.percentage >= 50 do %>
                <span class="badge badge-success">Passed</span>
              <% else %>
                <span class="badge badge-error">Failed</span>
              <% end %>
            </td>
            <td>
              <div class="flex gap-2">
                <.link
                  href={~p"/students/#{student.id}/edit"}
                  class="btn btn-sm btn-outline btn-primary transition-all duration-200 hover:scale-105"
                >Edit</.link>
                <.form
                  for={%{}}
                  action={~p"/students/#{student.id}"}
                  method="delete"
                  class="inline"
                  onsubmit="return confirm('Are you sure you want to delete this student?')"
                >
                  <button
                    type="submit"
                    class="btn btn-sm btn-error transition-all duration-200 hover:scale-105"
                  >Delete</button>
                </.form>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
