<div class="mx-auto w-full max-w-2xl px-6 py-8">
  <nav class="mb-8 flex flex-wrap gap-3 border-b border-base-300 pb-4">
    <.link
      href={~p"/"}
      class="rounded-lg bg-primary px-4 py-2 font-bold text-primary-content shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:shadow-md"
    >Home</.link>
    <.link
      href={~p"/students"}
      class="rounded-lg px-4 py-2 transition-all duration-200 hover:-translate-y-0.5 hover:bg-primary hover:text-primary-content hover:shadow-md"
    >All Students</.link>
    <.link
      href={~p"/class-analysis"}
      class="rounded-lg px-4 py-2 transition-all duration-200 hover:-translate-y-0.5 hover:bg-primary hover:text-primary-content hover:shadow-md"
    >Class Analysis</.link>
  </nav>
  <h1 class="mb-6 text-3xl font-bold">Edit Student</h1>

  <.form for={@changeset} action={~p"/students/#{@student.id}"} method="put" class="space-y-5">
    <div>
      <label for="student_name" class="mb-1 block font-medium">Student Name</label>
      <input
        id="student_name"
        name="name"
        value={@changeset.data.name}
        class="input input-bordered w-full"
        required
      />
    </div>

    <div>
      <label for="marks_obtained" class="mb-1 block font-medium">Marks Obtained</label>
      <input
        id="marks_obtained"
        name="marks_obtained"
        type="number"
        min="0"
        step="any"
        value={@changeset.data.marks_obtained}
        class="input input-bordered w-full"
        required
      />
    </div>

    <div>
      <label for="total_marks" class="mb-1 block font-medium">Total Marks</label>
      <input
        id="total_marks"
        name="total_marks"
        type="number"
        min="0.01"
        step="any"
        value={@changeset.data.total_marks}
        class="input input-bordered w-full"
        required
      />
    </div>

    <div class="flex gap-3">
      <button type="submit" class="btn btn-primary">Save Changes</button>
      <.link href={~p"/students"} class="btn btn-ghost">Cancel</.link>
    </div>
  </.form>
</div>
